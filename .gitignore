# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Training artifacts
trainer_output/
unsloth_compiled_cache/

# Logs
logs/

# Data (large files)
data/experiments/*/raw_dataset.jsonl
# All experiment outputs: LoRA adapters (126MB each), checkpoints, optimizer
# state, and verbose per-sample eval dumps. Regenerable and far over GitHub's
# 100MB/file limit. The distilled findings live in results/*.md instead.
data/experiments/
# Loose model weights anywhere
*.safetensors
optimizer.pt

# IDE
.idea/
.vscode/
*.swp

# Risk battery = HarmBench harmful prompts (regenerable via fetch_risk_battery.py)
data/risk-battery/

# Jacobian lens weights (100s of MB, regenerable via fit_jlens.py)
data/jspace/*.pt
data/jspace/*.ckpt

# Verbose per-sample ablation eval dumps (17MB); summaries alongside are kept
results/math_ablation/*/raw/
